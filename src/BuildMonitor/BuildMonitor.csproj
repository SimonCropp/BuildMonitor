<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
    WinExe rather than Exe. The dotnet tool shim inherits the subsystem of the entry assembly, so a
    WinExe tool gets a GUI shim: Run-at-login can point at the stable ~/.dotnet/tools/buildmonitor
    shim without a console window opening at every login. On macOS and Linux WinExe is an Exe. The
    console verbs (status, help) attach to the parent console on Windows before writing.
    -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BuildMonitor</AssemblyName>
    <!--
    The Win32 FileDescription, which is what a process list shows, and which defaults to the
    assembly name. One exe serves every verb, so a row cannot say which one it is running: a
    session that registered the MCP server leaves one of these per client, and "BuildMonitor" six
    times over reads as six trays rather than six adapters to the one. Description, in
    Directory.Build.props, is a different field: it lands in Comments, which no process list shows.
    -->
    <AssemblyTitle>BuildMonitor launcher and MCP server</AssemblyTitle>
    <PackageId>BuildMonitor</PackageId>
    <ToolCommandName>buildmonitor</ToolCommandName>
    <PackAsTool>true</PackAsTool>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RollForward>LatestMajor</RollForward>
    <!--
    RuntimeIdentifiers is deliberately NOT set. Combined with PackAsTool it empties the
    tools/net10.0/any payload. The heads are published per RID below and bundled beside it.
    -->
    <CreateRidSpecificToolPackages>false</CreateRidSpecificToolPackages>
    <!-- For the AttachConsole P/Invoke. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Text" />
    <Using Include="System.Text.Json" />
    <Using Include="System.ComponentModel" />
    <InternalsVisibleTo Include="BuildMonitor.Tests" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <ProjectReference Include="..\BuildMonitor.Core\BuildMonitor.Core.csproj" />
    <!--
    Ordering only. PlatformHeads shells out to dotnet publish for the heads, so without this a
    solution build can have two processes building a head at once. Every piece of metadata is
    load bearing: a plain reference would copy the head's output into this package.
    -->
    <ProjectReference Include="..\BuildMonitor.Windows\BuildMonitor.Windows.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      ExcludeAssets="all" />
    <ProjectReference Include="..\BuildMonitor.Native\BuildMonitor.Native.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      ExcludeAssets="all" />
  </ItemGroup>

  <!--
  Bundles a head per RID, so one install works on every platform, by PlatformHeads' targets: one
  framework dependent publish per RID, which gives a real apphost per platform, staged and then
  packed beside the launcher. They were this project's own targets, and DiffEngine's own beside
  them, each a copy of the other.

  Each RID names the head that renders on it. Every head produces a BuildMonitor.Tray apphost,
  so heads/{rid} keeps one shape and HeadLocator does not know which project it came from.
  Native says the head's renderer is a library committed under its runtimes folder, and one that
  is missing for a RID is warned of as PH0001.
  -->
  <ItemGroup>
    <PackageReference Include="PlatformHeads" PrivateAssets="all" />
    <PlatformHead Include="win-x64" Project="..\BuildMonitor.Windows\BuildMonitor.Windows.csproj" Apphost="BuildMonitor.Tray.exe" />
    <PlatformHead Include="win-arm64" Project="..\BuildMonitor.Windows\BuildMonitor.Windows.csproj" Apphost="BuildMonitor.Tray.exe" />
    <PlatformHead Include="linux-x64" Project="..\BuildMonitor.Native\BuildMonitor.Native.csproj" Apphost="BuildMonitor.Tray" Native="true" />
    <PlatformHead Include="linux-arm64" Project="..\BuildMonitor.Native\BuildMonitor.Native.csproj" Apphost="BuildMonitor.Tray" Native="true" />
    <PlatformHead Include="osx-x64" Project="..\BuildMonitor.Native\BuildMonitor.Native.csproj" Apphost="BuildMonitor.Tray" Native="true" />
    <PlatformHead Include="osx-arm64" Project="..\BuildMonitor.Native\BuildMonitor.Native.csproj" Apphost="BuildMonitor.Tray" Native="true" />
  </ItemGroup>

  <PropertyGroup>
    <!--
    PackAsTool packs the publish directory into tools/$(TargetFramework)/any, so the heads go
    beside it, each under its RID.
    -->
    <PlatformHeadsPackagePath>tools\$(TargetFramework)\any\heads</PlatformHeadsPackagePath>
    <!--
    Also into bin, so a Release build run from bin resolves a head the same way an installed tool
    does. Only for a build that packs, which a Release build is: a Debug build and a test run do
    not pay for the nested publishes. Set BuildMonitor_Head to run a head from a Debug build.
    -->
    <PlatformHeadsOutputPath Condition="'$(GeneratePackageOnBuild)' == 'true'">heads</PlatformHeadsOutputPath>
  </PropertyGroup>
</Project>
