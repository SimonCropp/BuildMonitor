<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- NativeTests calls the ABI as the head does, and half of it takes pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.Text" />
    <Using Include="System.Text.Json" />
    <Using Include="System.Net" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Net.Http.Headers" />
    <Using Include="System.Net.Sockets" />
    <Using Include="System.Collections.Immutable" />
    <Using Include="System.ComponentModel" />
    <Using Include="System.Runtime.InteropServices" />
    <PackageReference Include="Argon" />
    <PackageReference Include="MarkdownSnippets.MsBuild" PrivateAssets="all" />
    <PackageReference Include="Verify.TUnit" />
    <PackageReference Include="SimpleInfoName" />
    <PackageReference Include="Verify" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <ProjectReference Include="..\BuildMonitor.Core\BuildMonitor.Core.csproj" />
    <ProjectReference Include="..\BuildMonitor\BuildMonitor.csproj" />
    <ProjectReference Include="..\BuildMonitor.Native\BuildMonitor.Native.csproj" />
    <!--
    The native renderers belong to the head, but NativeTests and PixelTests exercise them through
    it, so this project needs whichever one matches the RID it is running on.
    -->
    <None Include="..\BuildMonitor.Native\runtimes\**\*"
          CopyToOutputDirectory="PreserveNewest"
          Link="runtimes\%(RecursiveDir)%(Filename)%(Extension)" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <!-- The live provider tests read their settings from the environment and user secrets. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
  </ItemGroup>
</Project>
