<?xml version='1.1' encoding='UTF-8'?>
<project>
  <description>BuildMonitor live test sandbox: prints a marker, waits, then fails.</description>
  <keepDependencies>false</keepDependencies>
  <properties/>
  <scm class="hudson.scm.NullSCM"/>
  <canRoam>true</canRoam>
  <disabled>false</disabled>
  <blockBuildWhenDownstreamBuilding>false</blockBuildWhenDownstreamBuilding>
  <blockBuildWhenUpstreamBuilding>false</blockBuildWhenUpstreamBuilding>
  <triggers/>
  <!-- One build at a time, so a second start waits in the queue for the live tests to cancel. -->
  <concurrentBuild>false</concurrentBuild>
  <builders>
    <hudson.tasks.Shell>
      <command>echo "BuildMonitor live test"
echo "BuildMonitor live test" &gt; marker.txt
sleep 60
exit 1</command>
    </hudson.tasks.Shell>
  </builders>
  <publishers>
    <!-- The live tests list and download this. onlyIfSuccessful is off because every build here
         fails, and Jenkins would otherwise archive nothing. -->
    <hudson.tasks.ArtifactArchiver>
      <artifacts>marker.txt</artifacts>
      <allowEmptyArchive>false</allowEmptyArchive>
      <onlyIfSuccessful>false</onlyIfSuccessful>
      <fingerprint>false</fingerprint>
      <defaultExcludes>true</defaultExcludes>
      <caseSensitive>true</caseSensitive>
      <followSymlinks>false</followSymlinks>
    </hudson.tasks.ArtifactArchiver>
  </publishers>
  <buildWrappers/>
</project>
