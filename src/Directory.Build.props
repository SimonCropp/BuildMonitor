<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Version>1.0.5</Version>
    <PackageTags>CI, Build, Monitor, Tray, MCP</PackageTags>
    <Description>Cross platform build/CI monitor that runs in the system tray.</Description>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <!-- Nothing consumes these assemblies as libraries, so there is no strong name to keep stable. -->
    <SignAssembly>false</SignAssembly>
    <ContinuousIntegrationBuild>false</ContinuousIntegrationBuild>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <ResolveAssemblyReferencesSilent>true</ResolveAssemblyReferencesSilent>
    <NoWarn>CS1591;CS0649;NU1608;NU1109;CA1416</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-08</Verify_SponsorshipExemptionUntil>
    <Papyrine_SponsorshipExemption>OpenSource</Papyrine_SponsorshipExemption>
    <Papyrine_SponsorshipExemptionUntil>2027-08</Papyrine_SponsorshipExemptionUntil>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.Runtime.CompilerServices" />
    <Using Include="System.Runtime.InteropServices" />
    <Using Include="System.Collections" />
    <Using Include="System.Collections.Concurrent" />
    <Using Include="System.Diagnostics" />
    <Using Include="System.Reflection" />
    <Using Include="System.ReadOnlySpan&lt;System.Char&gt;" Alias="CharSpan" />
  </ItemGroup>
  <!--
  The kernel PlatformHeads.Core shares with DiffEngine's viewer, for every project that sees
  BuildMonitor.Core. Its types are generic over a state and a screen, and these name them for
  this app's.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'IconBuilder' and '$(MSBuildProjectName)' != 'Packaging.Tests'">
    <Using Include="PlatformHeads" />
    <Using Include="PlatformHeads.SessionHost&lt;SessionState&gt;" Alias="SessionHost" />
    <Using Include="PlatformHeads.ScreenCache&lt;SessionState, Screen&gt;" Alias="ScreenCache" />
    <Using Include="PlatformHeads.OpenWindow&lt;IMonitorWindow&gt;" Alias="OpenWindow" />
    <Using Include="PlatformHeads.ITray&lt;TrayIconKind&gt;" Alias="ITray" />
    <Using Include="PlatformHeads.TrayModel&lt;TrayIconKind&gt;" Alias="TrayModel" />
    <Using Include="PlatformHeads.TrayNotification" Alias="Notification" />
    <Using Include="PlatformHeads.TrayNotificationKind" Alias="NotificationKind" />
  </ItemGroup>
</Project>
