<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Version>0.1.0-beta.16</Version>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <PackageTags>CI, Build, Monitor, Tray, MCP</PackageTags>
    <Description>Cross platform build/CI monitor that runs in the system tray.</Description>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <!-- Nothing consumes these assemblies as libraries, so there is no strong name to keep stable. -->
    <SignAssembly>false</SignAssembly>
    <ContinuousIntegrationBuild>false</ContinuousIntegrationBuild>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <ResolveAssemblyReferencesSilent>true</ResolveAssemblyReferencesSilent>
    <NoWarn>CS1591;CS0649;NU1608;NU1109;CA1416</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-08</Verify_SponsorshipExemptionUntil>
    <!-- IconifyBundle is maintained by the same author. -->
    <Papyrine_SponsorshipLicenseIgnored>true</Papyrine_SponsorshipLicenseIgnored>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.Runtime.CompilerServices" />
    <Using Include="System.Runtime.InteropServices" />
    <Using Include="System.Collections" />
    <Using Include="System.Collections.Concurrent" />
    <Using Include="System.Diagnostics" />
    <Using Include="System.Reflection" />
  </ItemGroup>
</Project>
