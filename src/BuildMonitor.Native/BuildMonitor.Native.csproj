<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Every head produces the same executable name; the launcher looks it up by RID folder. -->
    <AssemblyName>BuildMonitor.Tray</AssemblyName>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RollForward>LatestMajor</RollForward>
    <!--
    The libraries under runtimes are prebuilt by native/ and committed, so a plain dotnet build
    produces a shippable package on any machine and contributors never need CMake or Xcode.
    Regenerated by build-native.yml. This has PlatformHeads carry them into the output, which is
    what the launcher bundles: a RID-less build carries every architecture, so NativeResolver
    can pick at load time, and a RID-specific publish carries only its own.
    -->
    <PlatformHeadsNativeRuntimes>true</PlatformHeadsNativeRuntimes>
    <!-- Each method compiled once, as the Windows head does; see BuildMonitor.Windows.csproj for
    what tiering cost a tray. -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Text" />
    <Using Include="System.Diagnostics.CodeAnalysis" />
    <Using Include="Serilog" />
    <Using Include="Tmds.DBus.Protocol" />
    <InternalsVisibleTo Include="BuildMonitor.Tests" />
    <ProjectReference Include="..\BuildMonitor.Core\BuildMonitor.Core.csproj" />
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="PlatformHeads.Linux" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <PackageReference Include="PlatformHeads" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 4 MB of gen0 between collections rather than what the CPU's cache sizes it at, as the
    Windows head does; see BuildMonitor.Windows.csproj for what it saves. -->
    <RuntimeHostConfigurationOption Include="System.GC.Gen0MaxBudget" Value="0x400000" />
  </ItemGroup>
</Project>
