<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Every head produces the same executable name; the launcher looks it up by RID folder. -->
    <AssemblyName>BuildMonitor.Tray</AssemblyName>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Text" />
    <Using Include="System.Diagnostics.CodeAnalysis" />
    <Using Include="Serilog" />
    <Using Include="Tmds.DBus.Protocol" />
    <InternalsVisibleTo Include="BuildMonitor.Tests" />
    <ProjectReference Include="..\BuildMonitor.Core\BuildMonitor.Core.csproj" />
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
  </ItemGroup>

  <!--
  Prebuilt by native/ and committed, so a plain dotnet build produces a shippable package on any
  machine and contributors never need CMake or Xcode. Regenerated by build-native.yml.

  Not packed explicitly: CopyToOutputDirectory carries them into the publish output, which the
  launcher bundles. A RID-less build carries every architecture, so NativeResolver can pick at
  load time; a RID-specific publish carries only its own.
  -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == ''">
    <None Include="runtimes\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
    <None Include="runtimes\$(RuntimeIdentifier)\**\*"
          CopyToOutputDirectory="PreserveNewest"
          Link="runtimes\$(RuntimeIdentifier)\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
